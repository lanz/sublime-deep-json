* text=auto eol=lf
*.png binary
*.jpg binary

# Keep the installed package small. GitHub honors export-ignore when it builds the
# archive Package Control downloads, so everything below stays on the repository
# page without being installed into anyone's editor.
/dev export-ignore
/images export-ignore
/samples export-ignore
/screenshots export-ignore

*.sublime-project export-ignore
*.sublime-workspace export-ignore
